{% doc %}
  @prompt
    Random Product Dispaly gallery of 12 products with a see more button at bottom
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-random-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-random-products-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-random-products-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-random-products-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-random-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.button_spacing }}px;
  }

  .ai-random-product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-random-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .ai-random-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-random-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-random-product-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-random-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-random-product-info-{{ ai_gen_id }} {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-random-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-random-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 600;
    margin-top: auto;
  }

  .ai-random-products-button-wrapper-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-random-products-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease, transform 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .ai-random-products-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-random-products-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-random-products-empty-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  .ai-random-products-empty-message-{{ ai_gen_id }} {
    font-size: 18px;
    color: #999;
  }

  @media screen and (max-width: 749px) {
    .ai-random-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-random-products-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-random-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<random-product-gallery-{{ ai_gen_id }}
  class="ai-random-products-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-random-products-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-random-products-header-{{ ai_gen_id }}">
        <h2 class="ai-random-products-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    {% assign all_products = collections.all.products %}
    {% assign product_count = all_products.size %}

    {% if product_count > 0 %}
      <div class="ai-random-products-grid-{{ ai_gen_id }}">
        {% assign seed = 'now' | date: '%s' | modulo: 1000 %}
        {% assign displayed_count = 0 %}
        {% assign max_products = 12 %}

        {% for product in all_products limit: 50 %}
          {% if displayed_count < max_products %}
            {% assign random_check = forloop.index | times: seed | modulo: 3 %}
            {% if random_check == 0 or displayed_count < 6 %}
              {% assign displayed_count = displayed_count | plus: 1 %}
              <a
                href="{{ product.url }}"
                class="ai-random-product-card-{{ ai_gen_id }}"
              >
                <div class="ai-random-product-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 500 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-random-product-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="500"
                      height="500"
                    >
                  {% else %}
                    <div class="ai-random-product-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-random-product-info-{{ ai_gen_id }}">
                  <h3 class="ai-random-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <div class="ai-random-product-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </div>
                </div>
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <div class="ai-random-products-button-wrapper-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.button_link }}"
            class="ai-random-products-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-random-products-empty-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
        <p class="ai-random-products-empty-message-{{ ai_gen_id }}">
          No products available. Add products to your store to display them here.
        </p>
      </div>
    {% endif %}
  </div>
</random-product-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class RandomProductGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.shuffleProducts();
      }

      shuffleProducts() {
        const grid = this.querySelector('.ai-random-products-grid-{{ ai_gen_id }}');
        if (!grid) return;

        const cards = Array.from(grid.children);
        if (cards.length <= 1) return;

        for (let i = cards.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          grid.appendChild(cards[j]);
        }
      }
    }

    customElements.define('random-product-gallery-{{ ai_gen_id }}', RandomProductGallery{{ ai_gen_id }});
  })();
</script>

{% schema %}
