{% comment %}
  Category finder grid for the Balkonkraftwerke collection page.
  Shows a "Produktfinder" callout tile plus one tile per mounting-location
  sub-collection, each linking to its collection page.
{% endcomment %}

<div class="category-grid-section color-{{ section.settings.color_scheme }}">
  <div class="category-grid page-width">
    <div class="category-grid__intro">
      <h2 class="category-grid__heading">{{ section.settings.heading | escape }}</h2>
      <p class="category-grid__text">{{ section.settings.text | escape }}</p>
      <a href="{{ section.settings.finder_url }}" class="button category-grid__cta">
        {{ section.settings.button_label | escape }}
      </a>
    </div>

    <ul class="category-grid__list" role="list">
      <li class="category-grid__item">
        <a href="{{ section.settings.finder_url }}" class="category-grid__tile category-grid__tile--finder">
          <span class="category-grid__tile-icon">{{- 'icon-search.svg' | inline_asset_content -}}</span>
          <span class="category-grid__tile-label">{{ section.settings.finder_tile_label | escape }}</span>
        </a>
      </li>
      {%- for block in section.blocks -%}
        {%- assign cat_collection = block.settings.collection -%}
        <li class="category-grid__item">
          <a href="{{ cat_collection.url }}" class="category-grid__tile">
            {%- if cat_collection.image -%}
              {{
                cat_collection.image
                | image_url: width: 500
                | image_tag: loading: 'lazy', widths: '250,375,500', sizes: '(min-width: 990px) 33vw, 50vw', class: 'category-grid__tile-image', alt: cat_collection.title
              }}
            {%- endif -%}
            <span class="category-grid__tile-scrim"></span>
            <span class="category-grid__tile-label">{{ block.settings.label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% style %}
  .category-grid-section {
    padding: 3rem 0;
  }

  .category-grid__intro {
    max-width: 60rem;
    margin: 0 auto 2.4rem;
    text-align: center;
  }

  .category-grid__heading {
    margin: 0 0 0.8rem;
  }

  .category-grid__text {
    margin: 0 0 1.6rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .category-grid__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .category-grid__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .category-grid__tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.6rem;
    text-decoration: none;
    background: rgb(var(--color-foreground) / 0.04);
  }

  .category-grid__tile-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .category-grid__tile:hover .category-grid__tile-image {
    transform: scale(1.04);
  }

  .category-grid__tile-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.55) 100%);
  }

  .category-grid__tile-label {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 1.2rem;
    color: #fff;
    font-weight: 700;
    font-size: 1.6rem;
    text-align: center;
  }

  .category-grid__tile--finder {
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1rem;
    background: #5db13f;
  }

  .category-grid__tile--finder .category-grid__tile-icon {
    width: 3.6rem;
    height: 3.6rem;
    color: #fff;
  }

  .category-grid__tile--finder .category-grid__tile-icon svg {
    width: 100%;
    height: 100%;
  }

  .category-grid__tile--finder .category-grid__tile-label {
    position: static;
    padding: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "Category finder grid",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Finde dein passendes Balkonkraftwerk"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Nutze unseren Produktfinder oder wähle direkt deinen Montageort."
    },
    {
      "type": "url",
      "id": "finder_url",
      "label": "Produktfinder link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Zum Produktfinder"
    },
    {
      "type": "text",
      "id": "finder_tile_label",
      "label": "Produktfinder tile label",
      "default": "Produktfinder"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tile label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category finder grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
